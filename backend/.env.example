# Copy to backend/.env and fill in your local Postgres password. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:<your-password>@localhost:5432/resume_ai
# Or a cloud Postgres such as Aiven (keep the postgresql+psycopg:// prefix; SSL is required):
# DATABASE_URL=postgresql+psycopg://avnadmin:<password>@<host>.aivencloud.com:<port>/defaultdb?sslmode=require
# Required: the app won't start without it. Used by resume_structuring (AI extraction).
OPENAI_API_KEY=
# Optional (default 5): all-time AI spending cap in USD. Once the recorded AI cost reaches it,
# uploads get HTTP 402 ("AI spending limit reached. Uploads are paused.") until it is raised.
AI_SPEND_CAP_USD=5
